<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Cadastros"
            android:fontFamily="@font/matcha_home"
            android:textColor="@color/gold"
            android:textSize="24sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Organize as pessoas e os produtos usados nas vendas."
            android:textSize="13sp" android:textColor="@color/gray_hint"
            android:layout_marginTop="4dp" android:layout_marginBottom="20dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PESSOAS"
            android:fontFamily="@font/matcha_home"
            android:textColor="@color/gold"
            android:textSize="16sp" />
            <Button android:id="@+id/btnAddPerson" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Adicionar pessoa"
                android:textAllCaps="false" android:layout_marginTop="10dp" />
            <Button android:id="@+id/btnEditPeople" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Editar pessoas"
                android:textAllCaps="false" android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp"
            android:layout_marginTop="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PRODUTOS"
            android:fontFamily="@font/matcha_home"
            android:textColor="@color/gold"
            android:textSize="16sp" />
            <Button android:id="@+id/btnAddFood" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Adicionar produto"
                android:textAllCaps="false" android:layout_marginTop="10dp" />
            <Button android:id="@+id/btnEditFoods" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Editar produtos"
                android:textAllCaps="false" android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button android:id="@+id/btnAbout" style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/about_button"
            android:textAllCaps="false" android:textColor="@color/gold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="@string/copyright_notice"
            android:textColor="@color/gray_hint" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
